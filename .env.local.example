# DarwinSaaS — copy to .env.local and fill what you have. Everything has a working
# offline fallback, so the demo runs even with NONE of these set.

# --- Reliability switch ---
# Force the offline replay provider (guaranteed-complete demo, zero external calls):
DARWIN_MOCK=1
# Set DARWIN_MOCK=0 (or remove) to use real model calls.

# --- LLM: real debate ---
# Option A (SPONSOR, default): the InsForge Model Gateway — run `npx @insforge/cli ai setup`
# and it writes the project-provisioned OpenRouter key here. When set, this path wins.
OPENROUTER_API_KEY=sk-or-v1-...
DARWIN_GATEWAY_MODEL=anthropic/claude-sonnet-4.6
# Option B: direct Anthropic (needs a funded key)
ANTHROPIC_API_KEY=sk-ant-...
DARWIN_MODEL=claude-sonnet-4-6

# --- InsForge system of record (darwin_runs / darwin_events + the Species Archive) ---
INSFORGE_OSS_HOST=https://<project>.us-east.insforge.app
INSFORGE_API_KEY=ik_...

# --- Factory: real Vercel deploys (public URLs) ---
# Three ways to control deploys:
#   DARWIN_VERCEL=1   -> deploy using an already-logged-in `vercel` CLI session (no token)
#   VERCEL_TOKEN=...  -> deploy with an explicit token (CI / fresh machine)
#   DARWIN_VERCEL=0   -> force offline (build to .darwin/sites/<slug>, file:// URL)
# The public URL is the CLI's "Aliased:" line; the hash URL sits behind deploy protection.
DARWIN_VERCEL=1
VERCEL_TOKEN=

# --- Boardroom: the Replicas agent fleet (SPONSOR) ---
# USE_REPLICAS=1 runs the judges as real VM-isolated Replicas agents (needs a
# Replicas login session in ~/.replicas/config.json, or REPLICAS_API_KEY+REPLICAS_ORG_ID).
# DARWIN_FLEET_ROUNDS=1 (default) puts only the 10-idea cull round on the fleet (~4 min
# total demo); 2 = both rounds (~5.5 min). On any fleet error the in-process judges
# take over automatically.
USE_REPLICAS=1
DARWIN_FLEET_ROUNDS=1
REPLICAS_TIMEOUT_MS=60000

# --- Mutation: real Lighthouse via Google PageSpeed Insights ---
# Without this (or on a file:// URL), the offline structural SEO scorer is used.
PAGESPEED_API_KEY=
